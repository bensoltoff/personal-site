# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr cache directories. Local render accelerator only -- _freeze/ is the
# artifact that travels with the repo. These get large (100MB+ for the
# simulation-heavy posts), so they stay untracked.
*_cache/
/cache/

# Quarto scratch directory. _freeze/ and docs/ are deliberately NOT ignored:
# _freeze/ keeps old posts from re-executing, docs/ is what GitHub Pages serves.
/.quarto/

# Temporary files created by R markdown
*.utf8.md
*.knit.md
.Rproj.user

# _site
_site

# Excel temporary
~$*.xls*

# .DS_Store
.DS_Store

# README.html
README.html
LICENSE.html

# Jupyter notebooks
.ipynb_checkpoints/

# Spark logs
*.log
*spark.log*

**/*.quarto_ipynb
